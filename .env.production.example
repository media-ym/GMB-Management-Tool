# Production env for https://gmb.myfng.in (self-hosted Supabase)
# Copy to server as `.env` and fill secrets. Never commit real secrets.

NEXT_PUBLIC_APP_URL="https://gmb.myfng.in"
NEXTAUTH_URL="https://gmb.myfng.in"
NODE_ENV="production"
PORT=3000

# Self-hosted Supabase
NEXT_PUBLIC_SUPABASE_URL="https://supabase.yourdomain.com"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Prefer direct Postgres 5432 for Prisma (not Supavisor transaction mode)
DATABASE_URL="postgresql://postgres:STRONG_DB_PASSWORD@supabase-db:5432/postgres"

GOOGLE_CLIENT_ID="from-google-cloud-console"
GOOGLE_CLIENT_SECRET="from-google-cloud-console"
GOOGLE_REDIRECT_URI="https://gmb.myfng.in/api/google/callback"

TOKEN_ENCRYPTION_KEY="GENERATE_WITH_openssl_rand_-hex_32"
CRON_SECRET="GENERATE_WITH_openssl_rand_-hex_16"

# Optional — MiSA AI
OPENROUTER_API_KEY=""
OPENROUTER_HTTP_REFERER="https://gmb.myfng.in"
OPENROUTER_APP_TITLE="MyFNG"

# Optional — Places / Maps
GOOGLE_API_KEY=""

# Optional — billing dashboard
GOOGLE_CLOUD_PROJECT_ID=""
GCP_BILLING_ACCOUNT_ID=""

# Optional — Google Ads Keyword Planner
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

SEED_PASSWORD="CHANGE_ME"
