# Production env for https://gmb.myfng.in (self-hosted Supabase @ 89.116.21.158)
# Copy to server as `.env`. Never commit real secrets.

NEXT_PUBLIC_APP_URL="https://gmb.myfng.in"
NEXTAUTH_URL="https://gmb.myfng.in"
NODE_ENV="production"
PORT=3000

# ── Self-hosted Supabase ─────────────────────────────────────────────────────
# Browser: HTTPS same-origin proxy (next.config rewrites /supabase/* → Kong)
NEXT_PUBLIC_SUPABASE_BROWSER_URL="https://gmb.myfng.in/supabase"
NEXT_PUBLIC_SUPABASE_URL="http://89.116.21.158:8000"
SUPABASE_INTERNAL_URL="http://89.116.21.158:8000"

SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Direct Postgres on Supabase host (POSTGRES_PASSWORD from server .env)
DATABASE_URL="postgresql://postgres:POSTGRES_PASSWORD@89.116.21.158:5432/postgres?connection_limit=3&pool_timeout=20"
PRISMA_CONNECTION_LIMIT=3

GOOGLE_CLIENT_ID="from-google-cloud-console"
GOOGLE_CLIENT_SECRET="from-google-cloud-console"
GOOGLE_REDIRECT_URI="https://gmb.myfng.in/api/google/callback"

GOOGLE_PLACES_API_KEY=""
GOOGLE_API_KEY=""

TOKEN_ENCRYPTION_KEY="GENERATE_WITH_openssl_rand_-hex_32"
NEXTAUTH_SECRET="GENERATE_WITH_openssl_rand_-base64_32"
CRON_SECRET="GENERATE_WITH_openssl_rand_-hex_16"

OPENROUTER_API_KEY=""
OPENROUTER_HTTP_REFERER="https://gmb.myfng.in"
OPENROUTER_APP_TITLE="MyFNG"

GOOGLE_CLOUD_PROJECT_ID=""
GCP_BILLING_ACCOUNT_ID=""

GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""

SEED_PASSWORD="CHANGE_ME"
