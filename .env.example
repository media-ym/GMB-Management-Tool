# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Kept for backward-compatible redirects / media origin helpers
NEXTAUTH_URL="http://localhost:3000"

# ── Self-hosted Supabase ─────────────────────────────────────────────────────
# Kong / API URL (e.g. http://supabase.yourdomain.com or http://localhost:8000)
NEXT_PUBLIC_SUPABASE_URL="http://localhost:8000"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct Postgres (prefer port 5432 for Prisma; avoid transaction pooler)
# Example self-hosted:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# ── Google OAuth (GBP management — separate from Supabase Auth) ──────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Optional — Places / Maps
GOOGLE_API_KEY=""

# Required in production for /api/cron/*
CRON_SECRET="generate-with-openssl-rand-hex-16"

# Optional — token encryption at rest
TOKEN_ENCRYPTION_KEY=""

# Optional — MiSA AI (OpenRouter)
OPENROUTER_API_KEY=""
OPENROUTER_HTTP_REFERER="http://localhost:3000"
OPENROUTER_APP_TITLE="MyFNG Local AI Manager"

# Optional — Google Ads Keyword Planner
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# Optional — billing dashboard
GOOGLE_CLOUD_PROJECT_ID=""
GCP_BILLING_ACCOUNT_ID=""

# Optional — ngrok tunnel (dev only)
NGROK_AUTHTOKEN=""

# Seed / bootstrap password for scripts/supabase-bootstrap-users.mjs
SEED_PASSWORD="MyFNG@2025"
