# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ── Self-hosted Supabase (89.116.21.158) ─────────────────────────────────────
# Kong API (browser + server in dev)
NEXT_PUBLIC_SUPABASE_URL="http://89.116.21.158:8000"
# Direct Kong for server-side (optional; avoids proxy loop in production)
SUPABASE_INTERNAL_URL="http://89.116.21.158:8000"
# Production HTTPS only — browser uses same-origin proxy (next.config /supabase → Kong)
# NEXT_PUBLIC_SUPABASE_BROWSER_URL="https://gmb.myfng.in/supabase"

# API keys — self-hosted v2 format (from Supabase .env on the server)
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
# Legacy aliases (either pair works; app reads both)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Postgres — direct superuser (Prisma). Port 5432 on Supabase host.
# POSTGRES_PASSWORD from self-hosted Supabase .env
DATABASE_URL="postgresql://postgres:POSTGRES_PASSWORD@89.116.21.158:5432/postgres?connection_limit=3&pool_timeout=20"
PRISMA_CONNECTION_LIMIT=3

# Supabase Studio (manual SQL / cron): http://89.116.21.158:8001
# Login: supabase / DASHBOARD_PASSWORD from self-hosted .env

# S3 (Supabase Storage backend — configured on Supabase server, not in this app)
# S3_PROTOCOL_ACCESS_KEY_ID=
# S3_PROTOCOL_ACCESS_KEY_SECRET=

# ── Google OAuth (GBP management — separate from Supabase Auth) ──────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Server-side Places (rank tracking, competitors) — NO HTTP-referrer restriction
GOOGLE_PLACES_API_KEY=""
GOOGLE_API_KEY=""

CRON_SECRET="generate-with-openssl-rand-hex-16"
TOKEN_ENCRYPTION_KEY=""
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

OPENROUTER_API_KEY=""
OPENROUTER_HTTP_REFERER="http://localhost:3000"
OPENROUTER_APP_TITLE="MyFNG Local AI Manager"

GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

GOOGLE_CLOUD_PROJECT_ID=""
GCP_BILLING_ACCOUNT_ID=""

NGROK_AUTHTOKEN=""
